local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local P, W = game:GetService("Players"), game:GetService("Workspace")
local LP = P.LocalPlayer

local Win = Rayfield:CreateWindow({Name = "MM2", LoadingTitle = "กำลังโหลด...", LoadingSubtitle = "โดย บังเจษ🔑", ConfigurationSaving = {Enabled = false}})
local AutoCoin, ESPEnabled, SilentAim, KillAll, Speed = false, false, false, false, 0.3

local function GetRole(p)
   if not p then return "Innocent" end
   local c, b = p.Character, p:FindFirstChild("Backpack")
   if (c and (c:FindFirstChild("Knife") or c:FindFirstChild("Revolver"))) or (b and (b:FindFirstChild("Knife") or b:FindFirstChild("Revolver"))) then return "Murderer" end
   if (c and c:FindFirstChild("Gun")) or (b and b:FindFirstChild("Gun")) then return "Sheriff" end
   return "Innocent"
end

local function GetMurd() for _, p in pairs(P:GetPlayers()) do if p ~= LP and GetRole(p) == "Murderer" then return p end end end

local function ApplyESP(p)
   if p == LP or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then return end
   local c, r = p.Character, GetRole(p)
   if ESPEnabled and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
      local col = r == "Murderer" and Color3.fromRGB(255,0,0) or (r == "Sheriff" and Color3.fromRGB(0,120,255) or Color3.fromRGB(0,255,0))
      local hl = c:FindFirstChild("MM2_HL") or Instance.new("Highlight", c)
      hl.Name, hl.FillColor, hl.OutlineColor, hl.DepthMode = "MM2_HL", col, col, Enum.HighlightDepthMode.AlwaysOnTop
      local head = c:FindFirstChild("Head")
      if head then
         local tag = head:FindFirstChild("MM2_Tag") or Instance.new("BillboardGui", head)
         tag.Name, tag.Size, tag.StudsOffset, tag.AlwaysOnTop = "MM2_Tag", UDim2.new(0,100,0,40), Vector3.new(0,2.5,0), true
         local lbl = tag:FindFirstChild("L") or Instance.new("TextLabel", tag)
         lbl.Name, lbl.Size, lbl.BackgroundTransparency, lbl.TextScaled, lbl.Font, lbl.TextStrokeTransparency, lbl.TextColor3 = "L", UDim2.new(1,0,1,0), 1, true, Enum.Font.SourceSansBold, 0, col
         lbl.Text = p.DisplayName .. "\n[" .. (r == "Murderer" and "ฆาตกร" or (r == "Sheriff" and "นายอำเภอ" or "ผู้บริสุทธิ์")) .. "]"
      end
   else
      if c:FindFirstChild("MM2_HL") then c.MM2_HL:Destroy() end
      if c:FindFirstChild("Head") and c.Head:FindFirstChild("MM2_Tag") then c.Head.MM2_Tag:Destroy() end
   end
end

